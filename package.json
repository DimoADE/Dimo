{
  "name": "dimo",
  "version": "0.5.3",
  "private": true,
  "bin": {
    "dimo": "npx-cli/bin/cli.js"
  },
  "files": [
    "npx-cli/bin/cli.js",
    "npx-cli/dist/**"
  ],
  "scripts": {
    "lint": "pnpm run frontend:lint && pnpm run backend:lint",
    "format": "cargo fmt --all && cd frontend && pnpm run format",
    "check": "pnpm run frontend:check && pnpm run backend:check",
    "dev": "pnpm run dev:desktop",
    "dev:desktop": "pnpm run electron:dev",
    "frontend:build": "cd frontend && pnpm run build",
    "frontend:lint": "cd frontend && pnpm run lint",
    "frontend:check": "cd frontend && pnpm run check",
    "backend:lint": "cargo clippy --workspace --all-targets --features qa-mode -- -D warnings",
    "backend:dev": "node scripts/run-backend-standalone.js",
    "backend:check": "cargo check",
    "backend:dev:watch": "node scripts/run-backend-dev.js",
    "generate-types": "node scripts/run-generate-types.js",
    "generate-types:check": "node scripts/run-generate-types.js --check",
    "remote-protocol-schema": "node scripts/remote-protocol-schema.js",
    "remote-protocol-schema:check": "node scripts/remote-protocol-schema.js --check",
    "server:package-smoke": "pnpm run frontend:build && node scripts/smoke-dimo-server-package.js",
    "host-family:package": "node scripts/package-host-family.js",
    "test:host-family-package": "node --test scripts/package-host-family.test.js",
    "test:release-assets": "node --test scripts/release-assets.test.js npx-cli/bin/download.test.js",
    "test:host-family-install": "node scripts/smoke-host-family-install.js",
    "prepare-db": "node scripts/prepare-db.js",
    "prepare-db:check": "node scripts/prepare-db.js --check",
    "electron:dev": "node scripts/run-electron-dev.js",
    "electron:build": "pnpm --filter @dimo/electron build",
    "electron:check": "pnpm --filter @dimo/electron check",
    "electron:test": "pnpm --filter @dimo/electron test",
    "electron:stage-sidecars": "node scripts/stage-host-sidecars.js --electron",
    "electron:package:dir": "pnpm --filter @dimo/electron package:dir",
    "electron:package": "pnpm --filter @dimo/electron package",
    "test:tauri-bridge-manifest": "node --test scripts/generate-tauri-bridge-manifest.test.js",
    "generate-app-icons": "python3 scripts/generate-app-icons.py",
    "test:app-icon": "node --test scripts/check-app-icon.test.js scripts/installer-packaging.test.js",
    "test:web:e2e": "cd frontend && pnpm run test:e2e:web",
    "dependency:licenses": "node scripts/check-dependency-licenses.mjs",
    "plugin:no-privilege": "node scripts/check-plugin-no-privilege.mjs",
    "test:plugin-no-privilege": "node --test scripts/check-plugin-no-privilege.test.mjs",
    "arch:check": "node scripts/check-arch-invariants.mjs",
    "arch:check:json": "node scripts/check-arch-invariants.mjs --json",
    "test:arch-invariants": "node scripts/check-arch-invariants.test.mjs"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-fc5q-39xc-vjpf"
      ]
    },
    "overrides": {
      "devalue": "5.9.0",
      "dompurify": ">=3.4.17",
      "fast-uri": "4.1.2",
      "happy-dom": ">=21.0.4",
      "js-yaml@^4": ">=4.3.2",
      "lodash": "4.18.1",
      "lodash-es": "4.18.1",
      "adm-zip": "0.6.1",
      "nanoid@^3": "3.3.18",
      "postcss": "8.5.28",
      "rollup": "4.63.1",
      "source-map-js": "1.2.2",
      "undici": "7.30.1",
      "vite@^6": ">=6.4.4",
      "@astryxdesign/richtext>@astryxdesign/core": "0.7.1"
    },
    "patchedDependencies": {
      "@astryxdesign/core@0.3.0": "patches/@astryxdesign__core@0.3.0.patch"
    },
    "packageExtensions": {
      "@astryxdesign/richtext": {
        "dependencies": {
          "@astryxdesign/core": "0.7.1"
        }
      }
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "@astryxdesign/core": "0.3.0 || 0.7.1"
      }
    }
  },
  "packageManager": "pnpm@10.13.1"
}
